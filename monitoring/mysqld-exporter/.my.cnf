# ==============================================================================
# CẤU HÌNH XÁC THỰC CHO MYSQLD EXPORTER (.my.cnf)
# File này chứa thông tin tài khoản để mysqld_exporter kết nối vào MySQL Server
# và thu thập các chỉ số hiệu năng (metrics) định kỳ cho Prometheus.
# ==============================================================================

[client]
# Tên người dùng MySQL chuyên dụng cho việc giám sát (chỉ có quyền PROCESS, REPLICATION CLIENT, SELECT)
user=exporter

# Mật khẩu bảo mật của tài khoản exporter
password=Exporter_SecurePassword_2026!

# Địa chỉ máy chủ MySQL (sử dụng service name 'mysql' trong mạng nội bộ Docker)
host=mysql

# Cổng kết nối TCP của MySQL bên trong mạng Docker
port=3306
