# ==============================================================================
# CINEEVENT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Hệ thống đặt vé xem phim / sự kiện - Môn Triển khai & Quản trị Hệ thống
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000
JWT_SECRET=super_secret_jwt_key_cineevent_change_in_production_2026!
APP_URL=https://localhost

# MySQL Database Configuration
# Hardening note: Do NOT use root in backend application
MYSQL_ROOT_PASSWORD=Root_SecurePassword_2026!
MYSQL_DATABASE=cineevent_db
MYSQL_USER=cineevent_user
MYSQL_PASSWORD=CineEvent_UserSecurePass_2026!
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MySQL Exporter Account (Least privilege for Prometheus monitoring)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=Exporter_SecurePassword_2026!

# phpMyAdmin Configuration (Default 8085 to avoid conflict with host web servers)
PMA_PORT=8085

# Monitoring Credentials (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Grafana_AdminSecurePass_2026!
GRAFANA_PORT=3000

# Prometheus Port
PROMETHEUS_PORT=9090

# Loki & Promtail Ports
LOKI_PORT=3100

# cAdvisor & Nginx Exporter Ports (Internal / host)
CADVISOR_PORT=8081
NGINX_EXPORTER_PORT=9113
